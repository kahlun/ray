load("//bazel:python.bzl", "doctest")

doctest(
    files = glob(
        ["**/*.py"],
        exclude = [
            "**/thirdparty_files/**",
            # Importing pyzes loads libze_loader, so it can't be collected on
            # hosts without the Intel GPU driver.
            "thirdparty/pyzes/**",
        ],
    ),
    tags = ["team:core"],
)

filegroup(
    name = "src_files",
    srcs = glob(
        ["**/*.py"],
        exclude = ["**/thirdparty_files/**"],
    ),
    visibility = ["//:__pkg__"],
)
